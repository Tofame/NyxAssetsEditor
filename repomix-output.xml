		public async Task CopySpritesAsync(IEnumerable<SpriteViewModel> sprites)
		{
			var list = sprites.ToList();
			if (list.Count == 0)
				return;

			await SpriteClipboard.CopyManyAsync(list.Select(s => s.GetPixels()));
