				int minY = CanvasHeight;
				int maxY = -1;
				int count = 0;

				for (int y = 0; y < CanvasHeight; y++)
				{
					for (int x = 0; x < CanvasWidth; x++)
					{
						if (_selectionMask[x, y])
						{
							if (x < minX) minX = x;
							if (x > maxX) maxX = x;
							if (y < minY) minY = y;
							if (y > maxY) maxY = y;
							count++;
						}
					}
				}

				if (count == 0)
					return "-";

				int w = maxX - minX + 1;
				int h = maxY - minY + 1;
				return $"{w}x{h} px at ({minX}, {minY}) [{count} px]";
			}
		}

