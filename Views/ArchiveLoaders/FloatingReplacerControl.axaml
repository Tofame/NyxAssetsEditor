<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:NyxAssetsEditor.ViewModels.ArchiveLoaders"
			 xmlns:common="using:NyxAssetsEditor.Views.Common"
			 x:Class="NyxAssetsEditor.Views.ArchiveLoaders.FloatingReplacerControl"
			 x:DataType="vm:FloatingReplacerViewModel"
			 x:CompileBindings="False"
			 Width="{Binding DisplayWidth}">
	<UserControl.KeyBindings>
		<KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
		<KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
	</UserControl.KeyBindings>
	<UserControl.Styles>
		<Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#999"/><Setter Property="FontSize" Value="11"/></Style>
		<Style Selector="Button.mode.selected"><Setter Property="Background" Value="#335E94FF"/><Setter Property="BorderBrush" Value="#5E94FF"/></Style>
		<Style Selector="NumericUpDown.invalid">
			<Setter Property="BorderBrush" Value="#E24B4B"/>
			<Setter Property="BorderThickness" Value="2"/>
		</Style>
		<Style Selector="Button.replace">
			<Setter Property="Background" Value="#1F4D28"/>
			<Setter Property="BorderBrush" Value="#4CAF50"/>
			<Setter Property="Foreground" Value="#C8FFC8"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="Button.replace:disabled">
			<Setter Property="Background" Value="#2A2A2A"/>
			<Setter Property="BorderBrush" Value="#3A3A3A"/>
			<Setter Property="Foreground" Value="#666"/>
			<Setter Property="Opacity" Value="0.85"/>
		</Style>
		<Style Selector="ListBoxItem.preview-row">
			<Setter Property="Padding" Value="6,5"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</UserControl.Styles>
	<Border Background="#252525" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="8" BoxShadow="0 4 12 0 #7F000000">
		<Grid RowDefinitions="Auto,*">
			<Border Grid.Row="0" Name="TitleBar" Background="#2D2D2D" Height="36" Padding="12,0,6,0">
				<Border.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Undock" Command="{Binding UndockCommand}" IsVisible="{Binding !IsFloating}"/>
						<MenuItem Header="Dock Left" Command="{Binding SetDockStateCommand}" CommandParameter="Left" IsVisible="{Binding IsFloating}"/>
						<MenuItem Header="Dock Center" Command="{Binding SetDockStateCommand}" CommandParameter="Center" IsVisible="{Binding IsFloating}"/>
						<MenuItem Header="Dock Right" Command="{Binding SetDockStateCommand}" CommandParameter="Right" IsVisible="{Binding IsFloating}"/>
						<Separator/><MenuItem Header="Close" Command="{Binding ClosePanelCommand}"/>
					</ContextMenu>
				</Border.ContextMenu>
				<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
					<TextBlock Text="{Binding Title}" Foreground="#EEE" FontWeight="SemiBold" VerticalAlignment="Center"/>
					<Button Grid.Column="1" Command="{Binding UndoCommand}" Width="28" Height="24" Background="Transparent" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" ToolTip.Tip="Undo replacement (Ctrl+Z)">
						<Image Source="/Assets/Icons/action_undo.png" Width="14" Height="14"/>
					</Button>
					<Button Grid.Column="2" Command="{Binding RedoCommand}" Width="28" Height="24" Background="Transparent" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" ToolTip.Tip="Redo replacement (Ctrl+Y)">
						<Image Source="/Assets/Icons/action_redo.png" Width="14" Height="14"/>
					</Button>
					<Button Grid.Column="3" Command="{Binding ToggleMinimizeCommand}" Width="28" Height="24" Background="Transparent" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" ToolTip.Tip="Minimize">
						<Image Source="/Assets/Icons/action_minimize.png" Width="14" Height="14"/>
					</Button>
					<Button Grid.Column="4" Command="{Binding ClosePanelCommand}" Width="28" Height="24" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTip.Tip="Close">
						<Image Source="/Assets/Icons/action_close.png" Width="14" Height="14"/>
					</Button>
				</Grid>
			</Border>

			<Grid Grid.Row="1" IsVisible="{Binding !IsMinimized}" Height="{Binding DisplayHeight}" ColumnDefinitions="*,252">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="14" Margin="16">
					<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="Replace in" Classes="label" VerticalAlignment="Center"/>
								<Border Width="14" Height="14" CornerRadius="7" Background="#333" BorderBrush="#666"
									BorderThickness="1" VerticalAlignment="Center" Cursor="Help">
									<ToolTip.Tip>
										<TextBlock MaxWidth="300" TextWrapping="Wrap"
											Text="The archive that will be changed. Matching Thing IDs get the source definition. Sprites are matched by pixel content: reuse an equivalent target sprite, or append a unique copy at the end. Missing target Thing IDs are appended without gaps. Undo/Redo applies to this pair."/>
									</ToolTip.Tip>
									<TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#AAA"
										HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</StackPanel>
							<ComboBox ItemsSource="{Binding ArchivePairs}" SelectedItem="{Binding SelectedTargetPair}" PlaceholderText="No archive to replace in">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:ReplacementArchivePairViewModel">
										<StackPanel Spacing="2" ToolTip.Tip="{Binding ToolTipText}" MaxWidth="265">
											<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding DetailsText}" FontSize="10" Foreground="#777" TextTrimming="CharacterEllipsis"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="Take from" Classes="label" VerticalAlignment="Center"/>
								<Border Width="14" Height="14" CornerRadius="7" Background="#333" BorderBrush="#666"
									BorderThickness="1" VerticalAlignment="Center" Cursor="Help">
									<ToolTip.Tip>
										<TextBlock MaxWidth="300" TextWrapping="Wrap"
											Text="Read-only input for this replace. Replacer copies Things or Sprites from this pair's ID range — the source archive itself is never modified."/>
									</ToolTip.Tip>
									<TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#AAA"
										HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</StackPanel>
							<ComboBox ItemsSource="{Binding ArchivePairs}" SelectedItem="{Binding SelectedSourcePair}" PlaceholderText="No archive to copy from">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:ReplacementArchivePairViewModel">
										<StackPanel Spacing="2" ToolTip.Tip="{Binding ToolTipText}" MaxWidth="265">
											<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding DetailsText}" FontSize="10" Foreground="#777" TextTrimming="CharacterEllipsis"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
					</Grid>

					<Separator/>
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
						<StackPanel Spacing="4">
							<TextBlock Text="Replace" Classes="label"/>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<Button Classes="mode" Classes.selected="{Binding IsThingsMode}" Content="Things" Command="{Binding SetModeCommand}" CommandParameter="Things" Padding="14,6"/>
								<Button Classes="mode" Classes.selected="{Binding IsSpritesMode}" Content="Sprites" Command="{Binding SetModeCommand}" CommandParameter="Sprites" Padding="14,6"/>
							</StackPanel>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsThingsMode}">
							<TextBlock Text="Thing category" Classes="label"/>
							<ComboBox ItemsSource="{Binding ThingKinds}" SelectedItem="{Binding SelectedThingKind}" HorizontalAlignment="Stretch"/>
						</StackPanel>
					</Grid>

					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
						<StackPanel Spacing="4">
							<TextBlock Text="From ID" Classes="label"/>
							<NumericUpDown x:Name="FromIdInput" Value="{Binding FromId}" Minimum="0" Maximum="{Binding SourceMaxId}" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Classes.invalid="{Binding FromIdInvalid}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="4">
							<TextBlock Text="To ID (inclusive)" Classes="label"/>
							<NumericUpDown x:Name="ToIdInput" Value="{Binding ToId}" Minimum="0" Maximum="{Binding SourceMaxId}" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Classes.invalid="{Binding ToIdInvalid}"/>
						</StackPanel>
						<StackPanel Grid.Column="2" Spacing="4">
							<TextBlock Text="Target offset" Classes="label"/>
							<NumericUpDown Value="{Binding TargetOffset}" Increment="1" FormatString="0" ParsingNumberStyle="Integer"
								ToolTip.Tip="Added to each Take from ID to choose the Replace in ID. 0 keeps the same IDs. Example: 100–200 with offset 100 writes 200–300."/>
							<TextBlock Text="{Binding MappedTargetRangeText}" FontSize="10" Foreground="#888"/>
						</StackPanel>
					</Grid>

					<CheckBox IsVisible="{Binding IsSpritesMode}" IsChecked="{Binding KeepDiscardedSprites}"
						Content="Keep Discarded Sprites"
						ToolTip.Tip="When source and target pixels differ, save the overwritten target sprite as PNG under the app runtime folder replacer_backup, named {timestamp}_{sprite_id}.png. Identical sprites are not backed up. On by default."/>

					<Border IsVisible="{Binding IsThingsMode}" Background="#332A1600" BorderBrush="#8A6A2A" BorderThickness="1" CornerRadius="4" Padding="9">
						<TextBlock Foreground="#E6C36A" FontSize="11" TextWrapping="Wrap"
							Text="Frame conversion: extra unique source sprites are appended and remapped. If the source has fewer frames, surplus target sprites are kept and may become unreferenced; Replacer never deletes them automatically."/>
					</Border>

					<Border Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10" MinHeight="70">
						<ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
							<Grid>
								<TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#C8C8C8" FontSize="11" IsVisible="{Binding !HasError}"/>
								<TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#FF8888" FontSize="11" IsVisible="{Binding HasError}"/>
							</Grid>
						</ScrollViewer>
					</Border>

					<Button Content="Replace" Classes="replace" Command="{Binding ReplaceCommand}"
						HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,8"/>
				</StackPanel>
			</ScrollViewer>

			<Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#3C3C3C" BorderThickness="1,0,0,0">
				<Grid RowDefinitions="Auto,Auto,*,Auto">
					<TextBlock Text="{Binding PreviewCaption}" Classes="label" Margin="10,10,10,4"/>
					<Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="8,0,8,6">
						<TextBlock Text="Now" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
						<Image Grid.Column="1" Source="/Assets/Icons/arrow-circle-right.png" Width="14" Height="14" Margin="4,0"
							VerticalAlignment="Center" Stretch="Uniform"/>
						<TextBlock Grid.Column="2" Text="After" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
					</Grid>
					<ListBox x:Name="PreviewListBox" Grid.Row="2" ItemsSource="{Binding PreviewRows}" Background="Transparent" BorderThickness="0"
						Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						PointerWheelChanged="OnPreviewListBoxPointerWheelChanged"
						PointerPressed="OnPreviewListBoxPointerPressed">
						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="Padding" Value="6,4"/>
								<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
							</Style>
						</ListBox.Styles>
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:ReplacementPreviewRowViewModel">
								<Grid ColumnDefinitions="*,Auto,*">
									<StackPanel Spacing="2" HorizontalAlignment="Center">
										<Border Width="40" Height="40" Background="#111" CornerRadius="3" ClipToBounds="True">
											<common:IntegerScaledImage Source="{Binding CurrentPreview}" Width="40" Height="40"/>
										</Border>
										<TextBlock Text="{Binding CurrentIdText}" FontSize="10" Foreground="#BBB" HorizontalAlignment="Center"/>
										<TextBlock Text="{Binding CurrentHint}" FontSize="9" Foreground="#777" HorizontalAlignment="Center"
											IsVisible="{Binding !HasCurrent}"/>
									</StackPanel>
									<Image Grid.Column="1" Source="/Assets/Icons/arrow-circle-right.png" Width="14" Height="14"
										Margin="6,12,6,0" VerticalAlignment="Top" Stretch="Uniform"/>
									<StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
										<Border Width="40" Height="40" Background="#111" CornerRadius="3" ClipToBounds="True">
											<common:IntegerScaledImage Source="{Binding IncomingPreview}" Width="40" Height="40"/>
										</Border>
										<TextBlock Text="{Binding IncomingIdText}" FontSize="10" Foreground="#BBB" HorizontalAlignment="Center"/>
										<TextBlock Text="{Binding IncomingHint}" FontSize="9" Foreground="#777" HorizontalAlignment="Center"
											IsVisible="{Binding !HasIncoming}"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<Grid Grid.Row="3" ColumnDefinitions="24,24,*,24,24" ColumnSpacing="4" Margin="8,6,8,8" IsVisible="{Binding IsPreviewPagingVisible}">
						<Button Grid.Column="0" Command="{Binding FirstPreviewPageCommand}" IsEnabled="{Binding HasPreviousPreviewPage}" Width="24" Height="24" Padding="0" ToolTip.Tip="First Page">
							<Image Source="/Assets/Icons/arrow_m_left2.png" Width="12" Height="12"/>
						</Button>
						<Button Grid.Column="1" Command="{Binding PreviousPreviewPageCommand}" IsEnabled="{Binding HasPreviousPreviewPage}" Width="24" Height="24" Padding="0" ToolTip.Tip="Previous Page">
							<Image Source="/Assets/Icons/arrow_m_left.png" Width="12" Height="12"/>
						</Button>
						<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
							<TextBox Text="{Binding PreviewCurrentPage, Mode=TwoWay}" Width="52" Height="22" Padding="2,1" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="4" Foreground="#E0E0E0" ToolTip.Tip="Current page"/>
							<TextBlock Text="/" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding PreviewTotalPages}" Width="52" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Bold" Foreground="#E0E0E0" FontSize="10" VerticalAlignment="Center" ToolTip.Tip="Total pages"/>
						</StackPanel>
						<Button Grid.Column="3" Command="{Binding NextPreviewPageCommand}" IsEnabled="{Binding HasNextPreviewPage}" Width="24" Height="24" Padding="0" ToolTip.Tip="Next Page">
							<Image Source="/Assets/Icons/arrow_m_right.png" Width="12" Height="12"/>
						</Button>
						<Button Grid.Column="4" Command="{Binding LastPreviewPageCommand}" IsEnabled="{Binding HasNextPreviewPage}" Width="24" Height="24" Padding="0" ToolTip.Tip="Last Page">
							<Image Source="/Assets/Icons/arrow_m_right2.png" Width="12" Height="12"/>
						</Button>
					</Grid>
				</Grid>
			</Border>
			</Grid>

			<Canvas Name="AutoScrollCanvas" Grid.RowSpan="2" IsHitTestVisible="False" Background="Transparent" ZIndex="100">
				<Image Name="AutoScrollIndicator" Source="/Assets/Icons/mouse-scroll.png" Width="32" Height="32" IsVisible="False"/>
			</Canvas>

			<Border Name="ResizeLeft" Grid.RowSpan="2" Width="5" HorizontalAlignment="Left" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="SizeWestEast"/>
			<Border Name="ResizeRight" Grid.RowSpan="2" Width="5" HorizontalAlignment="Right" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="SizeWestEast"/>
			<Border Name="ResizeBottom" Grid.RowSpan="2" Height="5" VerticalAlignment="Bottom" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="SizeNorthSouth"/>
			<Border Name="ResizeCorner" Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="BottomRightCorner"/>
			<Border Name="ResizeBottomLeft" Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="BottomLeftCorner"/>
			<Border Name="ResizeTop" Grid.RowSpan="2" Height="5" VerticalAlignment="Top" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="SizeNorthSouth"/>
			<Border Name="ResizeTopRight" Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="TopRightCorner"/>
			<Border Name="ResizeTopLeft" Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" IsVisible="{Binding ShowResizeHandles}" Cursor="TopLeftCorner"/>
		</Grid>
	</Border>
</UserControl>
