<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:NyxAssetsEditor.ViewModels.ArchiveLoaders"
			 xmlns:local="using:NyxAssetsEditor.Views.ArchiveLoaders"
			 x:Class="NyxAssetsEditor.Views.ArchiveLoaders.FloatingThingEditorControl"
			 x:DataType="vm:FloatingThingEditorViewModel"
			 Name="RootEditorControl"
			 Width="{Binding DisplayWidth}"
			 Focusable="True">

	<UserControl.KeyBindings>
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
	</UserControl.KeyBindings>

	<UserControl.Resources>
		<ControlTheme x:Key="FlatSliderTheme" TargetType="Slider">
			<Setter Property="Background" Value="#252525"/>
			<Setter Property="Foreground" Value="#707070"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="MinHeight" Value="14"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}"
							BorderBrush="#3D3D3D"
							BorderThickness="1"
							CornerRadius="1"
							Height="14"
							VerticalAlignment="Center">
						<Track Name="PART_Track"
							   Minimum="{TemplateBinding Minimum}"
							   Maximum="{TemplateBinding Maximum}"
							   Value="{TemplateBinding Value, Mode=TwoWay}"
							   Orientation="Horizontal">
							<Track.DecreaseButton>
								<RepeatButton Name="PART_DecreaseButton"
											  Background="Transparent"
											  BorderThickness="0"
											  Focusable="False"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Stretch"/>
							</Track.DecreaseButton>
							<Track.IncreaseButton>
								<RepeatButton Name="PART_IncreaseButton"
											  Background="Transparent"
											  BorderThickness="0"
											  Focusable="False"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Stretch"/>
							</Track.IncreaseButton>
							<Thumb Name="thumb" Width="10" Height="12" Margin="0" Padding="0">
								<Thumb.Template>
									<ControlTemplate>
										<Border Name="ThumbBorder"
												Background="{TemplateBinding Foreground}"
												BorderBrush="#555555"
												BorderThickness="1"
												CornerRadius="1"/>
									</ControlTemplate>
								</Thumb.Template>
								<Thumb.Styles>
									<Style Selector="Thumb:pointerover /template/ Border#ThumbBorder">
										<Setter Property="Background" Value="#8A8A8A"/>
										<Setter Property="BorderBrush" Value="#6A6A6A"/>
									</Style>
									<Style Selector="Thumb:pressed /template/ Border#ThumbBorder">
										<Setter Property="Background" Value="#A0A0A0"/>
										<Setter Property="BorderBrush" Value="#8A8A8A"/>
									</Style>
								</Thumb.Styles>
							</Thumb>
						</Track>
					</Border>
				</ControlTemplate>
			</Setter>
		</ControlTheme>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Button.selected">
			<Setter Property="Background" Value="#335E94FF"/>
			<Setter Property="BorderBrush" Value="#5E94FF"/>
		</Style>
		<Style Selector="Button.icon-btn">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="#2A2A2A"/>
			<Setter Property="BorderBrush" Value="#444444"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="3"/>
		</Style>
		<Style Selector="Border.info-badge">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="Background" Value="#335E94FF"/>
			<Setter Property="BorderBrush" Value="#5E94FF"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Help"/>
			<Setter Property="IsVisible" Value="{Binding $parent[local:FloatingThingEditorControl].((vm:FloatingThingEditorViewModel)DataContext).ShowInformationBoxes}"/>
		</Style>
	</UserControl.Styles>

	<Border Background="#252525" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="8" BoxShadow="0 4 12 0 #7F000000">
		<Grid RowDefinitions="Auto, *, Auto">
			<Border Grid.Row="0" Name="TitleBar" Background="#2D2D2D" Height="36" Padding="12,0,6,0" IsVisible="{Binding ShowEditorTitleBar}">
				<Border.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Undock" Command="{Binding UndockCommand}" IsVisible="{Binding !IsFloating}"/>
						<MenuItem Header="Dock Left" Command="{Binding SetDockStateCommand}" CommandParameter="Left" IsVisible="{Binding IsFloating}"/>
						<MenuItem Header="Dock Center" Command="{Binding SetDockStateCommand}" CommandParameter="Center" IsVisible="{Binding IsFloating}"/>
						<MenuItem Header="Dock Right" Command="{Binding SetDockStateCommand}" CommandParameter="Right" IsVisible="{Binding IsFloating}"/>
						<Separator/>
						<MenuItem Header="Close" Command="{Binding ClosePanelCommand}"/>
					</ContextMenu>
				</Border.ContextMenu>
				<Grid ColumnDefinitions="*, Auto, Auto">
					<TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="13" VerticalAlignment="Center"/>
					<Button Grid.Column="1" Command="{Binding ToggleMinimizeCommand}" Width="28" Height="24" Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
						<Image Source="/Assets/Icons/action_minimize.png" Width="14" Height="14"/>
					</Button>
					<Button Grid.Column="2" Command="{Binding ClosePanelCommand}" Width="28" Height="24" Background="Transparent" BorderThickness="0">
						<Image Source="/Assets/Icons/action_close.png" Width="14" Height="14"/>
					</Button>
				</Grid>
			</Border>

			<TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" IsVisible="{Binding !IsMinimized}" Background="#222222" Height="{Binding DisplayHeight}" Padding="8">
				<TabItem Header="Texture">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled">
						<StackPanel Spacing="12" Margin="0,8,0,16">

							<!-- Appearance -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1">
								<StackPanel Spacing="8">
									<TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12"/>

									<!-- Outfit directions -->
									<Grid IsVisible="{Binding ShowOutfitDirections}" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" Width="120">
										<Button Grid.Row="0" Grid.Column="1" Classes.selected="{Binding IsDirectionNorth}" Command="{Binding SetDirectionNorthCommand}" Width="32" Height="28" Margin="2" HorizontalAlignment="Center" ToolTip.Tip="Face North">
											<Image Source="/Assets/Icons/arrow_m_up.png" Width="12" Height="12"/>
										</Button>
										<Button Grid.Row="1" Grid.Column="0" Classes.selected="{Binding IsDirectionWest}" Command="{Binding SetDirectionWestCommand}" Width="32" Height="28" Margin="2" HorizontalAlignment="Center" ToolTip.Tip="Face West">
											<Image Source="/Assets/Icons/arrow_m_left.png" Width="12" Height="12"/>
										</Button>
										<Button Grid.Row="1" Grid.Column="1" Classes.selected="{Binding IsDirectionSouth}" Command="{Binding SetDirectionSouthCommand}" Width="32" Height="28" Margin="2" HorizontalAlignment="Center" ToolTip.Tip="Face South">
											<Image Source="/Assets/Icons/arrow_m_down.png" Width="12" Height="12"/>
										</Button>
										<Button Grid.Row="1" Grid.Column="2" Classes.selected="{Binding IsDirectionEast}" Command="{Binding SetDirectionEastCommand}" Width="32" Height="28" Margin="2" HorizontalAlignment="Center" ToolTip.Tip="Face East">
											<Image Source="/Assets/Icons/arrow_m_right.png" Width="12" Height="12"/>
										</Button>
									</Grid>

									<Grid>
										<!-- Left controls panel (only for outfit) -->
										<StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" Spacing="8" IsVisible="{Binding IsOutfit}" Width="130">
											<CheckBox Content="Show All Directions" IsChecked="{Binding ShowAllOutfitDirections}" FontSize="10" Foreground="#AAA" Height="18" Padding="4,0,0,0" Margin="0"/>
											<StackPanel Spacing="4" IsVisible="{Binding !ShowAllOutfitDirections}">
												<CheckBox Content="Auto Rotate" IsChecked="{Binding AutoRotate}" FontSize="10" Foreground="#AAA" Height="18" Padding="4,0,0,0" Margin="0"/>
												<Grid ColumnDefinitions="Auto,*" IsVisible="{Binding AutoRotate}" Margin="0,2,0,0">
													<TextBlock Text="Speed (ms):" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
													<NumericUpDown Grid.Column="1" Value="{Binding RotateSpeedMs}" Minimum="50" Maximum="5000" Increment="50" Height="22" Padding="4,0" FontSize="10" ShowButtonSpinner="False"/>
												</Grid>
											</StackPanel>
										</StackPanel>

										<!-- Preview (centered) -->
										<StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
											<!-- Direction headers (only when ShowAllOutfitDirections is true) -->
											<Grid ColumnDefinitions="*,*,*,*" Width="{Binding AppearancePixelWidth}" IsVisible="{Binding ShowAllOutfitDirections}" Margin="8,0,8,4">
												<TextBlock Text="N" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
												<TextBlock Grid.Column="1" Text="E" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
												<TextBlock Grid.Column="2" Text="S" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
												<TextBlock Grid.Column="3" Text="W" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
											</Grid>

											<ScrollViewer HorizontalScrollBarVisibility="Auto"
														  VerticalScrollBarVisibility="Auto"
														  MaxHeight="360"
														  MaxWidth="480">
												<Border x:Name="AppearanceDropTarget"
														DragDrop.AllowDrop="True"
														DragDrop.DragEnter="OnAppearanceDragEnter"
														DragDrop.DragLeave="OnAppearanceDragLeave"
														DragDrop.DragOver="OnAppearanceDragOver"
														DragDrop.Drop="OnAppearanceDrop"
														Focusable="True"
														Background="#141414" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8"
														HorizontalAlignment="Center" VerticalAlignment="Top" MinWidth="80" MinHeight="80">
													<Border.ContextMenu>
														<ContextMenu>
															<MenuItem Header="Set Sprite ID..." Command="{Binding OpenSetSpriteIdPromptCommand}"/>
															<MenuItem Header="Clear" Command="{Binding ClearSelectedSlotCommand}"/>
															<Separator/>
															<MenuItem Header="Copy Sprite ID" Command="{Binding CopySelectedSlotCommand}" InputGesture="Ctrl+C"/>
															<MenuItem Header="Paste Sprite ID" Command="{Binding PasteSelectedSlotCommand}" InputGesture="Ctrl+V" IsEnabled="{Binding CanPasteSpriteId}"/>
														</ContextMenu>
													</Border.ContextMenu>
													<Image x:Name="AppearanceImageControl" Source="{Binding AppearanceImage, Mode=OneWay}" Stretch="None" RenderOptions.BitmapInterpolationMode="None"
														   HorizontalAlignment="Center" VerticalAlignment="Center"
														   PointerMoved="OnAppearancePointerMoved"
														   PointerExited="OnAppearancePointerExited"
														   PointerPressed="OnAppearancePointerPressed"/>
												</Border>
											</ScrollViewer>
										</StackPanel>
									</Grid>

									<!-- Bottom controls panel (missile buttons left-aligned at bottom, OB sliders right-aligned) -->
									<Grid Margin="0,4,0,0">
										<!-- Left: Missile generator buttons (bottom left of appearance section) -->
										<StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="6" IsVisible="{Binding IsMissile}">
											<Button Content="Generate 90° directions" Command="{Binding GenerateMissileOrthogonalDirectionsCommand}" ToolTip.Tip="Prepare 1 direction first" ToolTip.ShowOnDisabled="True" FontSize="10" Padding="6,4"/>
											<Button Content="Generate angled directions" Command="{Binding GenerateMissileDiagonalDirectionsCommand}" ToolTip.Tip="Prepare 1 direction first" ToolTip.ShowOnDisabled="True" FontSize="10" Padding="6,4"/>
											<Button Content="Generate all directions" Command="{Binding GenerateMissileAllDirectionsCommand}" ToolTip.Tip="Prepare 1 direction first" ToolTip.ShowOnDisabled="True" FontSize="10" Padding="6,4" BorderBrush="#FFD700" BorderThickness="1" Background="#2A2510" Foreground="#FFE082"/>
										</StackPanel>

										<!-- Left: Outfit addon buttons -->
										<StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="6">
											<Button Content="Duplicate frame → all" Command="{Binding AddonDuplicateFrameToAllCommand}"
													IsVisible="{Binding ShowAddonDuplicateFrameButton}"
													ToolTip.Tip="Copy the currently visible frame to all other directions and animation frames"
													FontSize="10" Padding="6,4" BorderBrush="#4FC3F7" BorderThickness="1" Background="#0D1F2D" Foreground="#81D4FA"/>
											<Button Content="Rotate &amp; clone direction" Command="{Binding AddonRotateCloneDirectionCommand}"
													IsVisible="{Binding ShowAddonRotateCloneButton}"
													ToolTip.Tip="Rotate all animation frames of the current direction to all other directions using RotSprite"
													FontSize="10" Padding="6,4" BorderBrush="#CE93D8" BorderThickness="1" Background="#1A0F2D" Foreground="#E1BEE7"/>
										</StackPanel>

										<!-- Right: Controls (OB-style) -->
										<StackPanel Spacing="6" HorizontalAlignment="Right">
										<Grid ColumnDefinitions="70,168,80" IsVisible="{Binding ShowFrameGroupSlider}">
											<TextBlock Grid.Column="0" Text="Group:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
											<Slider Grid.Column="1" Theme="{StaticResource FlatSliderTheme}" Minimum="0" Maximum="{Binding FrameGroupMaximum}" Value="{Binding SelectedFrameGroupIndex}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"/>
											<TextBlock Grid.Column="2" Text="{Binding FrameGroupDisplay, Mode=OneWay}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
										</Grid>

										<Grid ColumnDefinitions="70,168,80" IsVisible="{Binding ShowFrameSlider}">
											<TextBlock Grid.Column="0" Text="Animation:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
											<Slider Grid.Column="1" Theme="{StaticResource FlatSliderTheme}" Minimum="0" Maximum="{Binding FrameMaximum}" Value="{Binding SelectedFrame}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"/>
											<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
												<Button Classes="icon-btn" Classes.selected="{Binding IsAnimationPlaying}" Command="{Binding ToggleAnimationPreviewCommand}" ToolTip.Tip="Toggle animation preview">
													<Panel>
														<Image Source="/Assets/Icons/action_play.png" Width="10" Height="10" IsVisible="{Binding !IsAnimationPlaying}"/>
														<Image Source="/Assets/Icons/action_pause.png" Width="10" Height="10" IsVisible="{Binding IsAnimationPlaying}"/>
													</Panel>
												</Button>
												<TextBlock Text="{Binding FrameDisplay, Mode=OneWay}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
											</StackPanel>
										</Grid>

										<Grid ColumnDefinitions="70,168,80" IsVisible="{Binding ShowLayerSlider}">
											<TextBlock Grid.Column="0" Text="Layer:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
											<Slider Grid.Column="1" Theme="{StaticResource FlatSliderTheme}" Minimum="0" Maximum="{Binding LayerMaximum}" Value="{Binding SelectedLayer}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"/>
											<TextBlock Grid.Column="2" Text="{Binding LayerDisplay, Mode=OneWay}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
										</Grid>

										<Grid ColumnDefinitions="70,168,80" IsVisible="{Binding ShowAddonSlider}">
											<TextBlock Grid.Column="0" Text="Addon:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
											<Slider Grid.Column="1" Theme="{StaticResource FlatSliderTheme}" Minimum="0" Maximum="{Binding AddonMaximum}" Value="{Binding ViewPatternYIndex}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"/>
											<TextBlock Grid.Column="2" Text="{Binding PatternYDisplay, Mode=OneWay}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
										</Grid>

										<Grid ColumnDefinitions="70,168,80" IsVisible="{Binding ShowPatternZSlider}">
											<TextBlock Grid.Column="0" Text="Mount:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
											<Slider Grid.Column="1" Theme="{StaticResource FlatSliderTheme}" Minimum="0" Maximum="{Binding PatternZMaximum}" Value="{Binding ViewPatternZIndex}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"/>
											<TextBlock Grid.Column="2" Text="{Binding PatternZDisplay, Mode=OneWay}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
										</Grid>

										<StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" Margin="0,2,0,0">
											<ToggleSwitch Content="Show exact size" ToolTip.Tip="Show exact size (Crop Size)" IsChecked="{Binding ShowCropSize}" OnContent="" OffContent="" FontSize="11"/>
											<ToggleSwitch Content="Show grid" IsChecked="{Binding ShowGrid}" OnContent="" OffContent="" FontSize="11"/>
										</StackPanel>

										<Grid ColumnDefinitions="Auto,120,Auto" IsVisible="{Binding ShowDurationEditors}" HorizontalAlignment="Right" Margin="0,4,0,0">
											<TextBlock Grid.Column="0" Text="Min:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<NumericUpDown Grid.Column="1" Value="{Binding MinimumDuration}" Minimum="0" Maximum="60000" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11"/>
											<Button Grid.Column="2" Classes="icon-btn" Command="{Binding ApplyDefaultDurationsCommand}" ToolTip.Tip="Default durations" Margin="6,0,0,0">
												<Image Source="/Assets/Icons/action_editor_default_durations.png" Width="14" Height="14"/>
											</Button>
										</Grid>

										<Grid ColumnDefinitions="Auto,120,Auto" IsVisible="{Binding ShowDurationEditors}" HorizontalAlignment="Right">
											<TextBlock Grid.Column="0" Text="Max:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<NumericUpDown Grid.Column="1" Value="{Binding MaximumDuration}" Minimum="0" Maximum="60000" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11"/>
											<Button Grid.Column="2" Classes="icon-btn" Command="{Binding ApplyDurationForAllFramesCommand}" ToolTip.Tip="Set for all frames" Margin="6,0,0,0">
												<Image Source="/Assets/Icons/action_editor_apply_all.png" Width="14" Height="14"/>
											</Button>
										</Grid>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

							<!-- Patterns -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding HasPatterns}">
								<StackPanel Spacing="8" x:CompileBindings="False">
									<TextBlock Text="Patterns" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12"/>
									<Grid ColumnDefinitions="Auto,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Right">
										<TextBlock Grid.Row="0" Grid.Column="0" Text="Width:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,4"/>
										<NumericUpDown x:Name="PatternTileWidthNud" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="32" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4"/>
										<TextBlock Grid.Row="1" Grid.Column="0" Text="Height:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,4"/>
										<NumericUpDown x:Name="PatternTileHeightNud" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="32" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4"/>
										<StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,4" Spacing="4">
											<Button Command="{Binding InferCropSizeCommand}" Content="Auto" ToolTip.Tip="Infer exact size from empty pixels (Crop Size)" Padding="4,2" FontSize="9" Height="20" VerticalContentAlignment="Center"/>
											<TextBlock Text="Exact Size:" ToolTip.Tip="Exact Size (Crop Size)" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										</StackPanel>
										<NumericUpDown x:Name="PatternCropSizeNud" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="64" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4"/>
										<TextBlock Grid.Row="3" Grid.Column="0" Text="Layers:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,4"/>
										<NumericUpDown x:Name="PatternLayerCountNud" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="16" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4"/>
										<TextBlock Grid.Row="4" Grid.Column="0" Text="Pattern X:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,4"/>
										<NumericUpDown x:Name="PatternXCountNud" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="32" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4" IsEnabled="{Binding !IsOutfit}"/>
										<TextBlock Grid.Row="5" Grid.Column="0" Text="Pattern Y:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,4"/>
										<NumericUpDown x:Name="PatternYCountNud" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="32" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4"/>
										<TextBlock Grid.Row="6" Grid.Column="0" Text="Pattern Z:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,4"/>
										<NumericUpDown x:Name="PatternZCountNud" Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="16" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11" Margin="0,0,0,4"/>
										<TextBlock Grid.Row="7" Grid.Column="0" Text="Animations:" Foreground="#888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
										<NumericUpDown x:Name="PatternFrameCountNud" Grid.Row="7" Grid.Column="1" Minimum="1" Maximum="60" Increment="1" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11"/>
									</Grid>
								</StackPanel>
							</Border>

							<!-- Animation -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding ShowAnimationSection}">
								<StackPanel Spacing="8">
									<TextBlock Text="Animation" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12"/>
									<StackPanel Spacing="6" HorizontalAlignment="Right">
										<Grid ColumnDefinitions="Auto,170" HorizontalAlignment="Right">
											<TextBlock Grid.Column="0" Text="Mode:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<ComboBox Grid.Column="1" ItemsSource="{Binding AnimationModes, Mode=OneWay}" SelectedIndex="{Binding SelectedAnimationMode}" FontSize="11"/>
										</Grid>
										<Grid ColumnDefinitions="Auto,170" HorizontalAlignment="Right">
											<TextBlock Grid.Column="0" Text="Frame strategy:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<ComboBox Grid.Column="1" ItemsSource="{Binding FrameStrategies, Mode=OneWay}" SelectedIndex="{Binding FrameStrategyIndex}" FontSize="11"/>
										</Grid>
										<Grid ColumnDefinitions="Auto,120" IsVisible="{Binding ShowLoopCountEditor}" HorizontalAlignment="Right">
											<TextBlock Grid.Column="0" Text="Loop count:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<NumericUpDown Grid.Column="1" Value="{Binding AnimationLoopCount}" Minimum="0" Maximum="{Binding LoopCountMaximum}" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11"/>
										</Grid>
										<Grid ColumnDefinitions="Auto,120" HorizontalAlignment="Right">
											<TextBlock Grid.Column="0" Text="Start frame:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<NumericUpDown Grid.Column="1" Value="{Binding AnimationStartFrame}" Minimum="-1" Maximum="{Binding StartFrameMaximum}" Width="120" MinWidth="120" Height="28" Padding="4,0" FontSize="11"/>
										</Grid>
									</StackPanel>
								</StackPanel>
							</Border>

						</StackPanel>
					</ScrollViewer>
				</TabItem>

				<TabItem Header="Properties">
					<ScrollViewer>
						<StackPanel Spacing="8" Margin="0,8,0,16">
							<!-- Is Ground Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsItem}">
								<Grid ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Column="0" PropertyName="IsGround">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<ToggleSwitch Content="Is Ground" IsChecked="{Binding IsGround}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
											<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsFullGround]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
										</StackPanel>
									</local:BatchApplyField>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsGround}" VerticalAlignment="Center">
										<TextBlock Text="Ground Speed:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding GroundSpeed}" Minimum="0" Maximum="65535" Width="100" Height="28" Padding="4,0" FontSize="11"/>
									</StackPanel>
								</Grid>
							</Border>

							<!-- Has Light Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1">
								<Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Row="0" Grid.Column="0" PropertyName="HasLight">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<ToggleSwitch Content="Has Light" IsChecked="{Binding HasLight}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
											<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Light]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
										</StackPanel>
									</local:BatchApplyField>
									<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasLight}" VerticalAlignment="Center" Margin="0,0,0,4">
										<TextBlock Text="Light Color:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding LightColor}" Minimum="0" Maximum="215" Width="100" Height="28" Padding="4,0" FontSize="11"/>
										<Button Width="20" Height="20" Margin="4,0,0,0" BorderBrush="#444" BorderThickness="1" Background="{Binding LightColorBrush, Mode=OneWay}" ToolTip.Tip="Pick Light Color">
											<Button.Flyout>
												<Flyout Placement="BottomEdgeAlignedRight">
													<Border Background="#1E1E1E" BorderBrush="#353535" BorderThickness="1" CornerRadius="4" Padding="6" Width="268" Height="236">
														<ItemsControl ItemsSource="{Binding PaletteColors}" x:CompileBindings="False">
															<ItemsControl.ItemsPanel>
																<ItemsPanelTemplate>
																	<UniformGrid Columns="16" Rows="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																</ItemsPanelTemplate>
															</ItemsControl.ItemsPanel>
															<ItemsControl.ItemTemplate>
																<DataTemplate x:DataType="vm:FloatingThingEditorViewModel+PaletteColor">
																	<Button Width="14" Height="14" Margin="1" Padding="0" CornerRadius="0" BorderThickness="0" Background="{Binding Hex}" Command="{Binding $parent[UserControl].DataContext.SelectLightColorCommand}" CommandParameter="{Binding Index}"/>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</Border>
												</Flyout>
											</Button.Flyout>
										</Button>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasLight}" VerticalAlignment="Center">
										<TextBlock Text="Light Intensity:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding LightLevel}" Minimum="0" Maximum="255" Width="100" Height="28" Padding="4,0" FontSize="11"/>
										<Border Width="24"/>
									</StackPanel>
								</Grid>
							</Border>

							<!-- Automap Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsItem}">
								<Grid ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Column="0" PropertyName="MiniMap">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<ToggleSwitch Content="Automap" IsChecked="{Binding MiniMap}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
											<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[MinimapColor]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
										</StackPanel>
									</local:BatchApplyField>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding MiniMap}" VerticalAlignment="Center">
										<TextBlock Text="Automap Color:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding MiniMapColor}" Minimum="0" Maximum="215" Width="100" Height="28" Padding="4,0" FontSize="11"/>
										<Button Width="20" Height="20" Margin="4,0,0,0" BorderBrush="#444" BorderThickness="1" Background="{Binding MiniMapColorBrush, Mode=OneWay}" ToolTip.Tip="Pick Automap Color">
											<Button.Flyout>
												<Flyout Placement="BottomEdgeAlignedRight">
													<Border Background="#1E1E1E" BorderBrush="#353535" BorderThickness="1" CornerRadius="4" Padding="6" Width="268" Height="236">
														<ItemsControl ItemsSource="{Binding PaletteColors}" x:CompileBindings="False">
															<ItemsControl.ItemsPanel>
																<ItemsPanelTemplate>
																	<UniformGrid Columns="16" Rows="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																</ItemsPanelTemplate>
															</ItemsControl.ItemsPanel>
															<ItemsControl.ItemTemplate>
																<DataTemplate x:DataType="vm:FloatingThingEditorViewModel+PaletteColor">
																	<Button Width="14" Height="14" Margin="1" Padding="0" CornerRadius="0" BorderThickness="0" Background="{Binding Hex}" Command="{Binding $parent[UserControl].DataContext.SelectMiniMapColorCommand}" CommandParameter="{Binding Index}"/>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</Border>
												</Flyout>
											</Button.Flyout>
										</Button>
									</StackPanel>
								</Grid>
							</Border>

							<!-- Has Offset Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1">
								<Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Row="0" Grid.Column="0" PropertyName="HasOffset">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<ToggleSwitch Content="Has Offset" IsChecked="{Binding HasOffset}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
											<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Offset]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
										</StackPanel>
									</local:BatchApplyField>
									<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasOffset}" VerticalAlignment="Center" Margin="0,0,0,4">
										<TextBlock Text="Offset X:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding OffsetX}" Minimum="-1024" Maximum="1024" Width="100" Height="28" Padding="4,0" FontSize="11"/>
										<Button Width="28" Height="28" Padding="6" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Click="OnPreviewOffsetClick" ToolTip.Tip="Preview">
											<Image Source="/Assets/Icons/eye.png" Width="14" Height="14"/>
										</Button>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasOffset}" VerticalAlignment="Center">
										<TextBlock Text="Offset Y:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding OffsetY}" Minimum="-1024" Maximum="1024" Width="100" Height="28" Padding="4,0" FontSize="11"/>
									</StackPanel>
								</Grid>
							</Border>

							<!-- Has Elevation Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsItem}">
								<Grid ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Column="0" PropertyName="HasElevation">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<ToggleSwitch Content="Has Elevation" IsChecked="{Binding HasElevation}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
											<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Elevation]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
										</StackPanel>
									</local:BatchApplyField>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasElevation}" VerticalAlignment="Center">
										<TextBlock Text="Elevation:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding Elevation}" Minimum="0" Maximum="255" Width="100" Height="28" Padding="4,0" FontSize="11"/>
									</StackPanel>
								</Grid>
							</Border>
							<!-- Market Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding ShowMarket}">
								<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Row="0" Grid.Column="0" PropertyName="IsMarketItem">
										<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<ToggleSwitch Content="Market" IsChecked="{Binding IsMarketItem}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
											<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Market]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
										</StackPanel>
									</local:BatchApplyField>
									
									<Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto, *" IsEnabled="{Binding IsMarketItem}" Margin="0,6,0,6">
										<TextBlock Grid.Column="0" Text="Name:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
										<TextBox Grid.Column="1" Text="{Binding MarketName}" Height="28" Padding="6,4" FontSize="11" Background="#262626" BorderBrush="#3D3D3D"/>
									</Grid>

									<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsMarketItem}" Margin="0,0,0,4">
										<TextBlock Text="Category:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<ComboBox ItemsSource="{Binding MarketCategories}" SelectedIndex="{Binding MarketCategoryIndex}" Width="170" Height="28" FontSize="11"/>
									</StackPanel>

									<StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsMarketItem}" Margin="0,0,0,4">
										<TextBlock Text="Trade As:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding MarketTradeAs}" Minimum="0" Maximum="65535" Width="100" Height="28" Padding="4,0" FontSize="11"/>
									</StackPanel>

									<StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsMarketItem}" Margin="0,0,0,4">
										<TextBlock Text="Show As:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding MarketShowAs}" Minimum="0" Maximum="65535" Width="100" Height="28" Padding="4,0" FontSize="11"/>
									</StackPanel>

									<StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsMarketItem}">
										<TextBlock Text="Vocation:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
										<NumericUpDown Value="{Binding MarketRestrictProfession}" Minimum="0" Maximum="65535" Width="100" Height="28" Padding="4,0" FontSize="11" Margin="0,0,8,0"/>
										<TextBlock Text="Level:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<NumericUpDown Value="{Binding MarketRestrictLevel}" Minimum="0" Maximum="65535" Width="100" Height="28" Padding="4,0" FontSize="11"/>
									</StackPanel>
								</Grid>
							</Border>

							<!-- Write / Read Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsItem}">
								<StackPanel Spacing="6">
									<TextBlock Text="Write / Read" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6"/>
									<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
										<local:BatchApplyField Grid.Row="0" Grid.Column="0" PropertyName="Writable"><ToggleSwitch Content="Writable" IsChecked="{Binding Writable}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/></local:BatchApplyField>
										<local:BatchApplyField Grid.Row="1" Grid.Column="0" PropertyName="WritableOnce"><ToggleSwitch Content="Writable Once" IsChecked="{Binding WritableOnce}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/></local:BatchApplyField>
										<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsEnabled="{Binding Writable}">
											<TextBlock Text="Max Length:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
											<NumericUpDown Value="{Binding MaxTextLength}" Minimum="0" Maximum="65535" Width="100" Height="28" Padding="4,0" FontSize="11"/>
										</StackPanel>
									</Grid>
								</StackPanel>
							</Border>
							<!-- Has Action Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding ShowHasDefaultAction}">
								<Grid ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Column="0" PropertyName="HasDefaultAction"><ToggleSwitch Content="Has Action" IsChecked="{Binding HasDefaultAction}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/></local:BatchApplyField>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasDefaultAction}" VerticalAlignment="Center">
										<TextBlock Text="Action Type:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<ComboBox ItemsSource="{Binding DefaultActions}" SelectedIndex="{Binding DefaultActionIndex}" Width="170" Height="28" FontSize="11"/>
									</StackPanel>
								</Grid>
							</Border>

							<!-- Lens Help Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsItem}">
								<Grid ColumnDefinitions="*, Auto">
									<local:BatchApplyField Grid.Column="0" PropertyName="IsLensHelp"><ToggleSwitch Content="Lens Help" IsChecked="{Binding IsLensHelp}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/></local:BatchApplyField>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsLensHelp}" VerticalAlignment="Center">
										<TextBlock Text="Type:" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
										<ComboBox ItemsSource="{Binding LensHelpTypes}" SelectedIndex="{Binding LensHelpIndex}" Width="170" Height="28" FontSize="11"/>
									</StackPanel>
								</Grid>
							</Border>

								<!-- Outfit Flags Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsOutfit}">
								<StackPanel Spacing="6">
									<TextBlock Text="Flags" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,2"/>
									<local:BatchApplyField PropertyName="AnimateAlways">
										<ToggleSwitch Content="{Binding FlagLabel[AnimateAlways]}" ToolTip.Tip="{Binding FlagTooltip[AnimateAlways]}" IsChecked="{Binding AnimateAlways}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
									</local:BatchApplyField>
									<local:BatchApplyField PropertyName="DontCenterOutfit" IsVisible="{Binding FlagVisibility[DontCenterOutfit]}">
										<ToggleSwitch Content="{Binding FlagLabel[DontCenterOutfit]}" ToolTip.Tip="{Binding FlagTooltip[DontCenterOutfit]}" IsChecked="{Binding DontCenterOutfit}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
									</local:BatchApplyField>
								</StackPanel>
							</Border>

							<!-- Effect Flags Section -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsEffect}">
								<StackPanel Spacing="6">
									<TextBlock Text="Flags" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,2"/>
									<local:BatchApplyField PropertyName="BottomEffect" IsVisible="{Binding FlagVisibility[BottomEffect]}">
										<ToggleSwitch Content="{Binding FlagLabel[BottomEffect]}" ToolTip.Tip="{Binding FlagTooltip[BottomEffect]}" IsChecked="{Binding BottomEffect}" OnContent="" OffContent="" FontSize="11" VerticalAlignment="Center"/>
									</local:BatchApplyField>
								</StackPanel>
							</Border>

						</StackPanel>
					</ScrollViewer>
				</TabItem>

				<TabItem Header="Flags" IsVisible="{Binding IsItem}">
					<ScrollViewer>
						<StackPanel Spacing="8" Margin="0,8,0,16">
							<!-- DAT File Flags -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsDat}">
								<StackPanel Spacing="8">
									<TextBlock Text="Flags" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6"/>
									<Grid ColumnDefinitions="*, *">
										<!-- Left Column -->
										<StackPanel Grid.Column="0" Spacing="6" Margin="0,0,10,0">
											<!-- Radio buttons group -->
											<StackPanel Spacing="2" IsEnabled="{Binding !IsGround}" Margin="0,0,0,8">
												<RadioButton Content="Common" IsChecked="{Binding IsFlagsCommon}" FontSize="11"/>
												<RadioButton Content="Ground Border" IsChecked="{Binding IsFlagsGroundBorder}" IsVisible="{Binding ShowGroundBorder}" FontSize="11"/>
												<RadioButton Content="Bottom" IsChecked="{Binding IsFlagsBottom}" FontSize="11"/>
												<RadioButton Content="Top" IsChecked="{Binding IsFlagsTop}" FontSize="11"/>
											</StackPanel>

											<local:BatchApplyField PropertyName="IsContainer" IsVisible="{Binding FlagVisibility[IsContainer]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsContainer]}" ToolTip.Tip="{Binding FlagTooltip[IsContainer]}" IsChecked="{Binding IsContainer}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsContainer]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Stackable" IsVisible="{Binding FlagVisibility[Stackable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Stackable]}" ToolTip.Tip="{Binding FlagTooltip[Stackable]}" IsChecked="{Binding Stackable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Stackable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="ForceUse" IsVisible="{Binding FlagVisibility[ForceUse]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[ForceUse]}" ToolTip.Tip="{Binding FlagTooltip[ForceUse]}" IsChecked="{Binding ForceUse}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[ForceUse]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="MultiUse" IsVisible="{Binding FlagVisibility[MultiUse]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[MultiUse]}" ToolTip.Tip="{Binding FlagTooltip[MultiUse]}" IsChecked="{Binding MultiUse}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[MultiUse]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsFluidContainer" IsVisible="{Binding FlagVisibility[IsFluidContainer]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsFluidContainer]}" ToolTip.Tip="{Binding FlagTooltip[IsFluidContainer]}" IsChecked="{Binding IsFluidContainer}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsFluidContainer]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsFluid" IsVisible="{Binding FlagVisibility[IsFluid]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsFluid]}" ToolTip.Tip="{Binding FlagTooltip[IsFluid]}" IsChecked="{Binding IsFluid}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsFluid]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsUnpassable" IsVisible="{Binding FlagVisibility[IsUnpassable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsUnpassable]}" ToolTip.Tip="{Binding FlagTooltip[IsUnpassable]}" IsChecked="{Binding IsUnpassable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsUnpassable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsUnmoveable" IsVisible="{Binding FlagVisibility[IsUnmoveable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsUnmoveable]}" ToolTip.Tip="{Binding FlagTooltip[IsUnmoveable]}" IsChecked="{Binding IsUnmoveable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsUnmoveable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="BlockMissile" IsVisible="{Binding FlagVisibility[BlockMissile]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[BlockMissile]}" ToolTip.Tip="{Binding FlagTooltip[BlockMissile]}" IsChecked="{Binding BlockMissile}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[BlockMissile]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="BlockPathfind" IsVisible="{Binding FlagVisibility[BlockPathfind]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[BlockPathfind]}" ToolTip.Tip="{Binding FlagTooltip[BlockPathfind]}" IsChecked="{Binding BlockPathfind}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[BlockPathfind]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="FloorChange" IsVisible="{Binding FlagVisibility[FloorChange]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[FloorChange]}" ToolTip.Tip="{Binding FlagTooltip[FloorChange]}" IsChecked="{Binding FloorChange}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[FloorChange]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
										</StackPanel>

										<!-- Right Column -->
										<StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0">
											<local:BatchApplyField PropertyName="NoMoveAnimation" IsVisible="{Binding FlagVisibility[NoMoveAnimation]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[NoMoveAnimation]}" ToolTip.Tip="{Binding FlagTooltip[NoMoveAnimation]}" IsChecked="{Binding NoMoveAnimation}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[NoMoveAnimation]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Pickupable" IsVisible="{Binding FlagVisibility[Pickupable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Pickupable]}" ToolTip.Tip="{Binding FlagTooltip[Pickupable]}" IsChecked="{Binding Pickupable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Pickupable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Hangable" IsVisible="{Binding FlagVisibility[Hangable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Hangable]}" ToolTip.Tip="{Binding FlagTooltip[Hangable]}" IsChecked="{Binding Hangable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Hangable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsHorizontal" IsVisible="{Binding FlagVisibility[IsHorizontal]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsHorizontal]}" ToolTip.Tip="{Binding FlagTooltip[IsHorizontal]}" IsChecked="{Binding IsHorizontal}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsHorizontal]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsVertical" IsVisible="{Binding FlagVisibility[IsVertical]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsVertical]}" ToolTip.Tip="{Binding FlagTooltip[IsVertical]}" IsChecked="{Binding IsVertical}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsVertical]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Rotatable" IsVisible="{Binding FlagVisibility[Rotatable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Rotatable]}" ToolTip.Tip="{Binding FlagTooltip[Rotatable]}" IsChecked="{Binding Rotatable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Rotatable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="DontHide" IsVisible="{Binding FlagVisibility[DontHide]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[DontHide]}" ToolTip.Tip="{Binding FlagTooltip[DontHide]}" IsChecked="{Binding DontHide}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[DontHide]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsTranslucent" IsVisible="{Binding FlagVisibility[IsTranslucent]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsTranslucent]}" ToolTip.Tip="{Binding FlagTooltip[IsTranslucent]}" IsChecked="{Binding IsTranslucent}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsTranslucent]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsLyingObject" IsVisible="{Binding FlagVisibility[IsLyingObject]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsLyingObject]}" ToolTip.Tip="{Binding FlagTooltip[IsLyingObject]}" IsChecked="{Binding IsLyingObject}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsLyingObject]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IsFullGround" IsVisible="{Binding FlagVisibility[IsFullGround]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IsFullGround]}" ToolTip.Tip="{Binding FlagTooltip[IsFullGround]}" IsChecked="{Binding IsFullGround}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IsFullGround]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="IgnoreLook" IsVisible="{Binding FlagVisibility[IgnoreLook]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[IgnoreLook]}" ToolTip.Tip="{Binding FlagTooltip[IgnoreLook]}" IsChecked="{Binding IgnoreLook}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[IgnoreLook]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Usable" IsVisible="{Binding FlagVisibility[Usable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Usable]}" ToolTip.Tip="{Binding FlagTooltip[Usable]}" IsChecked="{Binding Usable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Usable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Wrappable" IsVisible="{Binding FlagVisibility[Wrappable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Wrappable]}" ToolTip.Tip="{Binding FlagTooltip[Wrappable]}" IsChecked="{Binding Wrappable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Wrappable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
											<local:BatchApplyField PropertyName="Unwrappable" IsVisible="{Binding FlagVisibility[Unwrappable]}">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<ToggleSwitch Content="{Binding FlagLabel[Unwrappable]}" ToolTip.Tip="{Binding FlagTooltip[Unwrappable]}" IsChecked="{Binding Unwrappable}" OnContent="" OffContent="" FontSize="11"/>
													<Border Classes="info-badge" ToolTip.Tip="{Binding FlagTooltip[Unwrappable]}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
												</StackPanel>
											</local:BatchApplyField>
										</StackPanel>
									</Grid>
								</StackPanel>
							</Border>

							<!-- JSON Schema-Defined Flags Header & Add Button -->
							<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsJson}" Margin="0,0,0,8">
								<Grid ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0" VerticalAlignment="Center">
										<TextBlock Text="Schema Flags" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12"/>
										<TextBlock Text="Predefined typed &amp; grouped flags for JSON format" Foreground="#777" FontSize="10"/>
									</StackPanel>
									<Button Grid.Column="1" Content="+ Define New Flag Schema" Command="{Binding OpenFlagCreatorCommand}" FontSize="11" Height="28" Padding="12,0" Background="#3A7BD5" Foreground="White"/>
								</Grid>
							</Border>

							<ItemsControl ItemsSource="{Binding CustomFlagGroups}" IsVisible="{Binding IsJson}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:FlagGroupViewModel">
									<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" Margin="0,0,0,8">
										<StackPanel Spacing="6">
											<TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
											
											<!-- Sub-Window Launcher Buttons inside Classification & Types section -->
											<WrapPanel Orientation="Horizontal" IsVisible="{Binding IsClassification}" Margin="0,0,0,8">
												<Button Content="Field Properties..." Command="{Binding $parent[UserControl].DataContext.OpenFieldModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
											</WrapPanel>

											<!-- Sub-Window Launcher Buttons inside Combat & Item Stats section -->
											<WrapPanel Orientation="Horizontal" IsVisible="{Binding IsStats}" Margin="0,0,0,8">
												<Button Content="Skills Boosts..." Command="{Binding $parent[UserControl].DataContext.OpenSkillsModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
												<Button Content="Health &amp; Mana..." Command="{Binding $parent[UserControl].DataContext.OpenHealthManaModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
												<Button Content="Element Damage..." Command="{Binding $parent[UserControl].DataContext.OpenElementsModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
												<Button Content="Protection &amp; Absorbs..." Command="{Binding $parent[UserControl].DataContext.OpenAbsorbsModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
												<Button Content="Critical &amp; Leech..." Command="{Binding $parent[UserControl].DataContext.OpenLeechModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
												<Button Content="Condition Suppressions..." Command="{Binding $parent[UserControl].DataContext.OpenSuppressionsModalCommand}" FontSize="11" Padding="10,5" Margin="0,0,6,6" Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3D3D3D" BorderThickness="1"/>
											</WrapPanel>

											<ItemsControl ItemsSource="{Binding Flags}">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
														<Grid ColumnDefinitions="*, Auto" Margin="0,2" VerticalAlignment="Center">
															<!-- Flag control -->
															<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
																<ContentControl.DataTemplates>
																	<!-- Bool flag: ToggleSwitch + Nested Child Flags Button (O) -->
																	<DataTemplate DataType="vm:BoolFlagViewModel">
																		<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
																			<ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding FullTooltip}"/>
																			<Border Classes="info-badge" ToolTip.Tip="{Binding FullTooltip}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
																			
																			<!-- Open Child Flags Modal Button (O) when checked -->
																			<Button Content="O" Command="{Binding $parent[UserControl].DataContext.OpenChildModalCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasChildFlags}" IsEnabled="{Binding IsChecked}" FontSize="11" FontWeight="Bold" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#3A7BD5" Foreground="White" ToolTip.Tip="Configure nested properties"/>
																		</StackPanel>
																	</DataTemplate>
																	<!-- Int flag: label + NumericUpDown -->
																	<DataTemplate DataType="vm:IntFlagViewModel">
																		<Grid ColumnDefinitions="150, Auto" VerticalAlignment="Center" Margin="0,2">
																			<DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
																				<Border Classes="info-badge" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip.Tip="{Binding FullTooltip}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
																				<TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding FullTooltip}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
																			</DockPanel>
																			<NumericUpDown Grid.Column="1" Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/>
																		</Grid>
																	</DataTemplate>
																	<!-- String flag: label + TextBox -->
																	<DataTemplate DataType="vm:StringFlagViewModel">
																		<Grid ColumnDefinitions="150, Auto" VerticalAlignment="Center" Margin="0,2">
																			<DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
																				<Border Classes="info-badge" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip.Tip="{Binding FullTooltip}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
																				<TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding FullTooltip}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
																			</DockPanel>
																			<TextBox Grid.Column="1" Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/>
																		</Grid>
																	</DataTemplate>
																	<!-- Enum flag: Dropdown or Radio Group -->
																	<DataTemplate DataType="vm:EnumFlagViewModel">
																		<StackPanel Spacing="4">
																			<Grid ColumnDefinitions="150, Auto" VerticalAlignment="Center" IsVisible="{Binding IsDropdown}">
																				<DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
																					<Border Classes="info-badge" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip.Tip="{Binding FullTooltip}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
																					<TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding FullTooltip}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
																				</DockPanel>
																				<ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" PlaceholderText="(None)" Width="180" FontSize="11" Height="28"/>
																			</Grid>
																			<StackPanel Spacing="4" IsVisible="{Binding IsRadio}">
																				<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
																					<TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding FullTooltip}"/>
																					<Border Classes="info-badge" ToolTip.Tip="{Binding FullTooltip}"><TextBlock Text="i" FontSize="9" FontWeight="Bold" Foreground="#5E94FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border>
																				</StackPanel>
																				<ItemsControl ItemsSource="{Binding Options}">
																					<ItemsControl.ItemsPanel>
																						<ItemsPanelTemplate>
																							<WrapPanel Orientation="Horizontal"/>
																						</ItemsPanelTemplate>
																					</ItemsControl.ItemsPanel>
																					<ItemsControl.ItemTemplate>
																						<DataTemplate DataType="x:String">
																							<RadioButton Content="{Binding}" GroupName="{Binding $parent[ItemsControl].DataContext.Name}" FontSize="11" Margin="0,0,12,4"/>
																						</DataTemplate>
																					</ItemsControl.ItemTemplate>
																				</ItemsControl>
																			</StackPanel>
																		</StackPanel>
																	</DataTemplate>
																</ContentControl.DataTemplates>
															</ContentControl>

															<!-- Right action controls: Lock icon + Delete Button -->
															<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
																<!-- Lock icon indicator -->
																<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
																<!-- Delete / Usage Button wrapper -->
																<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
																	<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
																</Border>
															</StackPanel>
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- JSON Ad-hoc Flags -->
						<Border Background="#1E1E1E" CornerRadius="6" Padding="12" BorderBrush="#353535" BorderThickness="1" IsVisible="{Binding IsJson}">
							<StackPanel Spacing="8">
								<TextBlock Text="Ad-hoc Flags" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6"/>
								<!-- Add ad-hoc flag input with type selector -->
								<Grid ColumnDefinitions="*, 110, Auto" Margin="0,0,0,8">
									<TextBox Grid.Column="0" Text="{Binding NewFlagName}" PlaceholderText="New flag key..." Height="28" Padding="6,4" FontSize="11" Background="#262626" BorderBrush="#3D3D3D"/>
									<ComboBox Grid.Column="1" SelectedIndex="{Binding NewFlagTypeIndex}" Margin="6,0,0,0" Height="28" FontSize="11" HorizontalAlignment="Stretch">
										<ComboBoxItem Content="Boolean"/>
										<ComboBoxItem Content="Integer"/>
										<ComboBoxItem Content="String"/>
									</ComboBox>
									<Button Grid.Column="2" Content="Add Flag" Command="{Binding AddAdHocFlagCommand}" Margin="6,0,0,0" FontSize="11" Height="28" Padding="10,0" Background="#3A7BD5" Foreground="White"/>
								</Grid>

								<Border Background="#262626" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="4" MaxHeight="200" IsVisible="{Binding AdHocFlags.Count}">
									<ScrollViewer>
										<ItemsControl ItemsSource="{Binding AdHocFlags}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:AdHocFlagViewModel">
													<Grid ColumnDefinitions="*, Auto" Margin="6,3">
														<!-- Bool -->
														<CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding BoolValue}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsBool}"/>
														<!-- Int -->
														<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsInt}">
															<TextBlock Text="{Binding Name}" FontSize="11" Foreground="#AAA" VerticalAlignment="Center" Width="110"/>
															<NumericUpDown Value="{Binding IntValue}" Width="120" FontSize="11" Height="26"/>
														</StackPanel>
														<!-- String -->
														<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsString}">
															<TextBlock Text="{Binding Name}" FontSize="11" Foreground="#AAA" VerticalAlignment="Center" Width="110"/>
															<TextBox Text="{Binding StringValue}" Width="160" FontSize="11" Height="26" Padding="4,2" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
														</StackPanel>
														<Button Grid.Column="1" Content="Delete" Command="{Binding RemoveCommand}" FontSize="10" Background="#D9534F" Foreground="White" Padding="6,2" Height="20" VerticalAlignment="Center"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
								</Border>
							</StackPanel>
						</Border>
						</StackPanel>
					</ScrollViewer>
				</TabItem>
			</TabControl>
			<!-- Resize handles -->
			<Border Grid.RowSpan="3" Name="ResizeLeft" Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeRight" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeBottom" Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeCorner" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeBottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeTop" Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeTopLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>
			<Border Grid.RowSpan="3" Name="ResizeTopRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" ZIndex="100"
					IsVisible="{Binding ShowEditorResizeHandles}"/>

			<!-- Footer with Save & Cancel Buttons -->
			<Border Grid.Row="2" Name="BottomBar" Background="#2D2D2D" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0" Height="44" Padding="12,0" IsVisible="{Binding !IsMinimized}">
				<Grid ColumnDefinitions="*, Auto, Auto">
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Width="80" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Background="#3D3D3D" Foreground="#E0E0E0"/>
						<Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Width="80" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Background="#3A7BD5" Foreground="White"/>
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowAddSpriteConfirmation}" CornerRadius="8">
				<Border Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<StackPanel Spacing="12">
						<TextBlock Text="Add sprite?" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" FontSize="13"/>
						<TextBlock Text="{Binding AddSpriteConfirmationText, Mode=OneWay}" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap"/>
						<Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
							<Button Grid.Column="0" Content="Cancel" Command="{Binding CancelAddSpriteCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
							<Button Grid.Column="1" Content="Add sprite" Command="{Binding ConfirmAddSpriteCommand}" Background="#3A7BD5" Foreground="White" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
						</Grid>
					</StackPanel>
				</Border>
			</Border>

			<!-- Navigation Prompt Overlay -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowPromptOverlay}" CornerRadius="8">
				<Border Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<StackPanel Spacing="12">
						<TextBlock Text="{Binding PromptTitle}" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" FontSize="13"/>
						<TextBlock Text="{Binding PromptText}" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap" HorizontalAlignment="Center"/>
						<Grid ColumnDefinitions="*, *, *" Margin="0,8,0,0">
							<Button Grid.Column="0" Content="Save" Command="{Binding PromptSaveCommand}" Background="#3A7BD5" Foreground="White" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
							<Button Grid.Column="1" Content="Don't Save" Command="{Binding PromptDontSaveCommand}" Margin="4,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
							<Button Grid.Column="2" Content="Cancel" Command="{Binding PromptCancelCommand}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
						</Grid>
					</StackPanel>
				</Border>
			</Border>
			<!-- Set Sprite ID Prompt Overlay -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowSetSpriteIdPrompt}" CornerRadius="8">
				<Border Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<StackPanel Spacing="12">
						<TextBlock Text="Set Sprite ID" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" FontSize="13"/>
						<TextBox Text="{Binding TargetSpriteIdText}" PlaceholderText="Enter Sprite ID..." FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
						<Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
							<Button Grid.Column="0" Content="Cancel" Command="{Binding CancelSetSpriteIdCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
							<Button Grid.Column="1" Content="OK" Command="{Binding ConfirmSetSpriteIdCommand}" Background="#3A7BD5" Foreground="White" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,6"/>
						</Grid>
					</StackPanel>
				</Border>
			</Border>

			<!-- Flag Creator Modal Overlay -->
			<Border Grid.RowSpan="3" Background="#C0000000" IsVisible="{Binding ShowFlagCreatorModal}" CornerRadius="8" ZIndex="200">
				<Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="20" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 24 0 #9F000000">
					<StackPanel Spacing="12">
						<TextBlock Text="Define New Flag Schema" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,4"/>

						<!-- Key -->
						<StackPanel Spacing="4">
							<TextBlock Text="Flag Key (ExtraProperties key):" FontSize="11" Foreground="#AAA"/>
							<TextBox Text="{Binding CreatorKey}" PlaceholderText="e.g. max_level, article" FontSize="11" Height="28" Padding="6,4" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
						</StackPanel>

						<!-- Label & Group in 2 cols -->
						<Grid ColumnDefinitions="*, *">
							<StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
								<TextBlock Text="Display Label:" FontSize="11" Foreground="#AAA"/>
								<TextBox Text="{Binding CreatorLabel}" PlaceholderText="e.g. Maximum Level" FontSize="11" Height="28" Padding="6,4" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
								<TextBlock Text="Group / Section:" FontSize="11" Foreground="#AAA"/>
								<TextBox Text="{Binding CreatorGroup}" PlaceholderText="e.g. Text Properties" FontSize="11" Height="28" Padding="6,4" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
							</StackPanel>
						</Grid>

						<!-- Type Selector -->
						<StackPanel Spacing="4">
							<TextBlock Text="Flag Type:" FontSize="11" Foreground="#AAA"/>
							<ComboBox SelectedIndex="{Binding CreatorTypeIndex}" HorizontalAlignment="Stretch" FontSize="11" Height="28">
								<ComboBoxItem Content="Boolean (ToggleSwitch)"/>
								<ComboBoxItem Content="Integer (NumericUpDown)"/>
								<ComboBoxItem Content="String (TextBox)"/>
								<ComboBoxItem Content="Enum (Dropdown)"/>
								<ComboBoxItem Content="Enum (Radio Group)"/>
							</ComboBox>
						</StackPanel>

						<!-- Lock option -->
						<CheckBox Content="Lock Flag (unremovable via editor, TOML-only)" IsChecked="{Binding CreatorLocked}" FontSize="11" Margin="0,2,0,4"/>

						<!-- Default Value -->
						<StackPanel Spacing="4">
							<TextBlock Text="Default Value:" FontSize="11" Foreground="#AAA"/>
							<TextBox Text="{Binding CreatorDefault}" PlaceholderText="e.g. true, 100, Fire" FontSize="11" Height="28" Padding="6,4" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
						</StackPanel>

						<!-- Description (Optional) -->
						<StackPanel Spacing="4">
							<TextBlock Text="Description (optional tooltip text):" FontSize="11" Foreground="#AAA"/>
							<TextBox Text="{Binding CreatorDescription}" PlaceholderText="Explain what this custom flag does..." FontSize="11" Height="28" Padding="6,4" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
						</StackPanel>

						<!-- Int specific bounds -->
						<Grid ColumnDefinitions="*, *" IsVisible="{Binding IsCreatorTypeInt}">
							<StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
								<TextBlock Text="Min Value:" FontSize="11" Foreground="#AAA"/>
								<NumericUpDown Value="{Binding CreatorMin}" FontSize="11" Height="28"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
								<TextBlock Text="Max Value:" FontSize="11" Foreground="#AAA"/>
								<NumericUpDown Value="{Binding CreatorMax}" FontSize="11" Height="28"/>
							</StackPanel>
						</Grid>

						<!-- Enum options list -->
						<StackPanel Spacing="4" IsVisible="{Binding IsCreatorTypeEnum}">
							<TextBlock Text="Enum Options (comma-separated):" FontSize="11" Foreground="#AAA"/>
							<TextBox Text="{Binding CreatorOptionsRaw}" PlaceholderText="Fire, Ice, Energy, Earth" FontSize="11" Height="28" Padding="6,4" Background="#1E1E1E" BorderBrush="#3D3D3D"/>
						</StackPanel>

						<!-- Modal Buttons -->
						<Grid ColumnDefinitions="*, *" Margin="0,12,0,0">
							<Button Grid.Column="0" Content="Cancel" Command="{Binding CloseFlagCreatorCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,8" Background="#3D3D3D" Foreground="#E0E0E0"/>
							<Button Grid.Column="1" Content="Save &amp; Define Flag" Command="{Binding SaveFlagDefinitionCommand}" Background="#3A7BD5" Foreground="White" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="0,8"/>
						</Grid>
					</StackPanel>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Skills Boosts -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowSkillsModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Skill Boosts &amp; Stats" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure skill points, magic level, and HP/Mana bonuses" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding SkillsFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseSkillsModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Element Damage -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowElementsModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Elemental Damage Modifiers" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure elemental weapon attack damage values" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding ElementsFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseElementsModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Protection & Absorbs -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowAbsorbsModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Protection &amp; Damage Absorbs (%)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure percentage elemental and magic resistance" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding AbsorbsFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseAbsorbsModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Critical & Leech -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowLeechModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Critical &amp; Life / Mana Leech" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure critical hit, life leech, and mana leech values" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding LeechFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseLeechModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Health & Mana -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowHealthManaModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Health &amp; Mana Regeneration / Shield" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure health gain, mana gain, ticks, and mana shield" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding HealthManaFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseHealthManaModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>
			<!-- Sub-Window Modal: Condition Suppressions -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowSuppressionsModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Condition Suppressions" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure condition immunity flags (fire, poison, energy, drunk, etc.)" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding SuppressionsFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseSuppressionsModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Magic Field Properties -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowFieldModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="440" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="Magic Field Properties" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure field type, periodic/initial damage, count, and tick rates" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="380">
							<ItemsControl ItemsSource="{Binding FieldFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
												<Image Source="avares://NyxAssetsEditor/Assets/Icons/lock.png" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockTooltip}"/>
												<Border ToolTip.Tip="{Binding DeleteTooltip}" Background="Transparent" VerticalAlignment="Center">
													<Button Content="✕" Command="{Binding RemoveFlagCommand}" IsEnabled="{Binding CanDelete}" FontSize="11" FontWeight="Bold" Foreground="White" Background="#D9534F" Width="22" Height="22" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseFieldModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>

			<!-- Sub-Window Modal: Nested Child Flags Overlay (Container, etc.) -->
			<Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding ShowChildModal}" CornerRadius="8">
				<Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="420" MaxHeight="480" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #7F000000">
					<Grid RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Margin="0,0,0,12">
							<TextBlock Text="{Binding ActiveChildFlag.Label, StringFormat='{}Nested Flags: {0}'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
							<TextBlock Text="Configure sub-properties for this flag" FontSize="11" Foreground="#888888"/>
						</StackPanel>
						<ScrollViewer Grid.Row="1" MaxHeight="320">
							<ItemsControl ItemsSource="{Binding ActiveChildFlag.ChildFlags}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CustomFlagViewModelBase">
										<Grid ColumnDefinitions="*, Auto" Margin="0,4" VerticalAlignment="Center">
											<ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center">
												<ContentControl.DataTemplates>
													<DataTemplate DataType="vm:BoolFlagViewModel"><ToggleSwitch Content="{Binding Label}" IsChecked="{Binding IsChecked}" OnContent="" OffContent="" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}"/></DataTemplate>
													<DataTemplate DataType="vm:IntFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><NumericUpDown Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="120" FontSize="11" Height="28"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:StringFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><TextBox Text="{Binding Value}" Width="180" FontSize="11" Height="28" Padding="6,4" Background="#262626" BorderBrush="#3D3D3D"/></StackPanel></DataTemplate>
													<DataTemplate DataType="vm:EnumFlagViewModel"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding LabelColor}" ToolTip.Tip="{Binding LowUsageWarning}" VerticalAlignment="Center" Width="140"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Width="180" FontSize="11" Height="28"/></StackPanel></DataTemplate>
												</ContentControl.DataTemplates>
											</ContentControl>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button Grid.Row="2" Content="Close" Command="{Binding CloseChildModalCommand}" Margin="0,12,0,0" HorizontalAlignment="Right" Width="90" Height="28" Background="#3A7BD5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center"/>
					</Grid>
				</Border>
			</Border>
		</Grid>
	</Border>
</UserControl>
