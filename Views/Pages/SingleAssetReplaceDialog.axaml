<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="NyxAssetsEditor.Views.Pages.SingleAssetReplaceDialog"
		Title="Replace"
		Width="440"
		SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		Background="#141414"
		RequestedThemeVariant="Dark"
		ShowInTaskbar="False">
	<Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
		<StackPanel>
			<Border Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="15,12">
				<TextBlock Name="HeadingText" FontSize="14" FontWeight="SemiBold" Foreground="#F0F0F0"/>
			</Border>
			<StackPanel Spacing="12" Margin="20,16">
				<Border Name="DropZone" Height="130" Background="#181818" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="6"
					Cursor="Hand" PointerPressed="OnDropZonePressed"
					DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
						<Image Source="/Assets/Icons/action_replace.png" Width="28" Height="28"/>
						<TextBlock Name="DropInstructionText" Foreground="#D0D0D0" TextAlignment="Center"/>
						<TextBlock Name="SelectedFileText" Foreground="#888888" FontSize="11" TextAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>
				<CheckBox Name="ReplaceSpritesCheckBox" Content="Replace sprites" IsChecked="False" IsVisible="False" Foreground="#D0D0D0" FontSize="12"
					ToolTip.Tip="When checked, existing sprite IDs are overwritten in-place with new pixels. When unchecked, new sprites are appended to the end of the archive."/>
				<TextBlock Name="ErrorText" IsVisible="False" Foreground="#FF8888" FontSize="11" TextWrapping="Wrap"/>
				<Grid ColumnDefinitions="*,Auto,Auto">
					<Button Grid.Column="1" Name="ConfirmButton" Content="Confirm" IsEnabled="False" Padding="14,7" Margin="0,0,6,0"
						Background="#3A1A1A" BorderBrush="#6A3A3A" Foreground="#FF9A9A" Click="OnConfirmClick"/>
					<Button Grid.Column="2" Content="Cancel" Padding="14,7" Click="OnCancelClick"/>
				</Grid>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
