<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:pages="using:NyxAssetsEditor.Views.Pages"
		x:Class="NyxAssetsEditor.Views.Pages.AssetImportDialog"
		Title="Import"
		Width="480"
		SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		Background="#141414"
		RequestedThemeVariant="Dark"
		ShowInTaskbar="False">

	<Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
		<StackPanel Spacing="0">
			<Border Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="15,12">
				<TextBlock Name="TitleText" Text="Import" FontSize="14" FontWeight="SemiBold" Foreground="#F0F0F0"/>
			</Border>

			<Border Padding="20,15">
				<StackPanel Spacing="14">
					<StackPanel Spacing="4">
						<TextBlock Text="Input Folder" Foreground="#A0A0A0" FontSize="11"/>
						<Grid ColumnDefinitions="*,Auto">
							<TextBox Name="PathInput" PlaceholderText="Select folder…" Height="28" VerticalContentAlignment="Center"/>
							<Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Padding="10,6" FontSize="11" Click="OnBrowseClick"/>
						</Grid>
					</StackPanel>

					<StackPanel Spacing="4">
						<Grid ColumnDefinitions="*,Auto,Auto">
							<TextBlock Name="PreviewLabel" Text="Preview" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
							<Button Grid.Column="1" Content="All" FontSize="10" Padding="8,3" Margin="0,0,4,0"
								Background="#2A2A2A" BorderBrush="#444" Foreground="#CCC" Click="OnSelectAllClick"/>
							<Button Grid.Column="2" Content="None" FontSize="10" Padding="8,3"
								Background="#2A2A2A" BorderBrush="#444" Foreground="#CCC" Click="OnSelectNoneClick"/>
						</Grid>
						<Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Background="#181818" Height="280">
							<ListBox Name="PreviewList" Background="Transparent" BorderThickness="0" Padding="6,6,2,6"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ScrollViewer.VerticalScrollBarVisibility="Visible">
								<ListBox.Styles>
									<Style Selector="ListBoxItem">
										<Setter Property="Padding" Value="4,4"/>
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									</Style>
								</ListBox.Styles>
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="pages:AssetImportPreviewItem">
										<Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
											<CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
											<Grid Grid.Column="1" Width="64" Height="64">
												<Border Background="#111" CornerRadius="3" ClipToBounds="True">
													<Image Source="{Binding Preview}" Width="64" Height="64" Stretch="Uniform"/>
												</Border>
												<Grid Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
													Margin="0,-2,-2,0" IsVisible="{Binding IsDuplicate}"
													ToolTip.Tip="Already in this archive (same front frame)">
													<Ellipse Width="16" Height="16" Fill="#E6B800"/>
													<TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#1A1400"
														HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Grid>
											</Grid>
											<StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
												<TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#EEE" TextTrimming="CharacterEllipsis"/>
												<TextBlock Text="{Binding Details}" FontSize="10" Foreground="#888" TextTrimming="CharacterEllipsis"/>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Border>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Padding="20,8,20,15">
				<Grid ColumnDefinitions="*,Auto,Auto">
					<TextBlock Name="StatusText" Text="" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
					<Button Grid.Column="1" Name="ImportButton"
							Content="Import"
							Padding="14,6" Margin="0,0,6,0"
							Background="#1A3A1A" BorderBrush="#3A6A3A" BorderThickness="1"
							Foreground="#88CC88" FontSize="12" CornerRadius="4"
							Click="OnImportClick"/>
					<Button Grid.Column="2" Content="Cancel"
							Padding="14,6"
							Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1"
							Foreground="#AAAAAA" FontSize="12" CornerRadius="4"
							Click="OnCancelClick"/>
				</Grid>
			</Border>
		</StackPanel>
	</Border>
</Window>
