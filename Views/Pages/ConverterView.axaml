<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:NyxAssetsEditor.ViewModels.Pages"
			 x:Class="NyxAssetsEditor.Views.Pages.ConverterView"
			 x:DataType="vm:ConverterViewModel">
	<Grid RowDefinitions="Auto, *, Auto" Margin="30">
		<!-- Header -->
		<StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
			<TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="#5E94FF"/>
			<TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="14" Foreground="#888888" TextWrapping="Wrap"/>
		</StackPanel>

		<!-- Main Tabs -->
		<TabControl Grid.Row="1">
			<!-- Tab 1: Sprite Converter -->
			<TabItem Header="Sprite Converter">
				<ScrollViewer>
					<StackPanel Spacing="15" Margin="0,15,0,0">
						<Border Background="#1E1E1E" CornerRadius="8" Padding="20">
							<StackPanel Spacing="15">
								<TextBlock Text="SPR ↔ Assets Converter" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
								
								<Grid ColumnDefinitions="160, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
									<!-- Conversion Direction -->
									<TextBlock Grid.Row="0" Grid.Column="0" Text="Mode:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="20">
										<RadioButton Content="SPR to Assets" IsChecked="{Binding SprToAssetsMode}" GroupName="SprMode"/>
										<RadioButton Content="Assets to SPR" IsChecked="{Binding !SprToAssetsMode}" GroupName="SprMode"/>
									</StackPanel>

									<!-- Source Path -->
									<TextBlock Grid.Row="1" Grid.Column="0" Text="Source File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SprSourcePath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="OnBrowseSprSource" Padding="12,4"/>

									<!-- Target Path -->
									<TextBlock Grid.Row="2" Grid.Column="0" Text="Target File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SprTargetPath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="OnBrowseSprTarget" Padding="12,4"/>

									<!-- Settings -->
									<TextBlock Grid.Row="3" Grid.Column="0" Text="SPR Extended IDs:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SprExtendedIds}"/>

									<TextBlock Grid.Row="4" Grid.Column="0" Text="SPR Transparent Pixels:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding SprTransparentPixels}"/>

									<!-- Client Version -->
									<TextBlock Grid.Row="5" Grid.Column="0" Text="Client Version:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SprClientVersionText}" Width="120" Height="28" VerticalContentAlignment="Center"/>

									<!-- Format specific settings -->
									<TextBlock Grid.Row="6" Grid.Column="0" Text="Compression (Assets):" VerticalAlignment="Center" Foreground="#CCCCCC" IsVisible="{Binding SprToAssetsMode}"/>
									<ComboBox Grid.Row="6" Grid.Column="1" SelectedIndex="{Binding SprCompressionLevel}" IsVisible="{Binding SprToAssetsMode}" Width="120" Height="28">
										<ComboBoxItem Content="Level 0"/>
										<ComboBoxItem Content="Level 1"/>
										<ComboBoxItem Content="Level 2"/>
										<ComboBoxItem Content="Level 3 (Default)"/>
										<ComboBoxItem Content="Level 4"/>
										<ComboBoxItem Content="Level 5"/>
									</ComboBox>

									<TextBlock Grid.Row="6" Grid.Column="0" Text="Signature (SPR):" VerticalAlignment="Center" Foreground="#CCCCCC" IsVisible="{Binding !SprToAssetsMode}"/>
									<TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SprSignatureText}" IsVisible="{Binding !SprToAssetsMode}" Width="120" Height="28" VerticalContentAlignment="Center"/>
								</Grid>

								<Button Content="Convert Sprites" Command="{Binding ExecuteSprConversionCommand}" IsEnabled="{Binding !IsBusy}" Background="#5E94FF" Foreground="#FFFFFF" Padding="20,10" HorizontalAlignment="Left" Margin="0,10,0,0"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- Tab 2: Thing Converter -->
			<TabItem Header="Thing Converter">
				<ScrollViewer>
					<StackPanel Spacing="15" Margin="0,15,0,0">
						<Border Background="#1E1E1E" CornerRadius="8" Padding="20">
							<StackPanel Spacing="15">
								<TextBlock Text="DAT ↔ JSON Things Converter" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>

								<Grid ColumnDefinitions="160, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
									<!-- Mode Selection -->
									<TextBlock Grid.Row="0" Grid.Column="0" Text="Mode:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="20">
										<RadioButton Content="DAT to JSON" IsChecked="{Binding DatToThingsMode}" GroupName="DatMode"/>
										<RadioButton Content="JSON to DAT" IsChecked="{Binding !DatToThingsMode}" GroupName="DatMode"/>
									</StackPanel>

									<!-- Source Path -->
									<TextBlock Grid.Row="1" Grid.Column="0" Text="Source File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatSourcePath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="OnBrowseDatSource" Padding="12,4"/>

									<!-- Target Path -->
									<TextBlock Grid.Row="2" Grid.Column="0" Text="Target File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DatTargetPath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="OnBrowseDatTarget" Padding="12,4"/>

									<!-- Client Version -->
									<TextBlock Grid.Row="3" Grid.Column="0" Text="Client Version:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
										<TextBox Text="{Binding DatClientVersionText}" Width="100" Height="28" VerticalContentAlignment="Center"/>
										<TextBlock Text="(e.g., 860 for 8.60, 1098 for 10.98)" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
									</StackPanel>

									<!-- Compatibility Options -->
									<TextBlock Grid.Row="4" Grid.Column="0" Text="Extended Sprite IDs:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding DatExtendedIds}"/>

									<TextBlock Grid.Row="5" Grid.Column="0" Text="Improved Animations:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding DatImprovedAnimations}"/>

									<TextBlock Grid.Row="6" Grid.Column="0" Text="Outfit Frame Groups:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding DatOutfitFrameGroups}"/>

									<TextBlock Grid.Row="7" Grid.Column="0" Text="Transparent Sprites:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding DatTransparentSprites}"/>
								</Grid>

								<Button Content="Convert Things" Command="{Binding ExecuteDatConversionCommand}" IsEnabled="{Binding !IsBusy}" Background="#5E94FF" Foreground="#FFFFFF" Padding="20,10" HorizontalAlignment="Left" Margin="0,10,0,0"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- Tab 3: Target Version Migrator -->
			<TabItem Header="Version Migrator">
				<ScrollViewer>
					<StackPanel Spacing="15" Margin="0,15,0,0">
						<Border Background="#1E1E1E" CornerRadius="8" Padding="20">
							<StackPanel Spacing="15">
								<TextBlock Text="Target Client Version Migrator" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
								<TextBlock Text="Migrate SPR/DAT assets from an older Tibia client version to a newer version (e.g. 8.60 to 10.98) or vice versa. Handles required formatting adaptations like animations timing layout." FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>

								<Grid ColumnDefinitions="160, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
									<!-- Source Assets -->
									<TextBlock Grid.Row="0" Grid.Column="0" Text="Source .spr File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MigSourceSprPath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="OnBrowseMigSourceSpr" Padding="12,4"/>

									<TextBlock Grid.Row="1" Grid.Column="0" Text="Source .dat File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MigSourceDatPath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="OnBrowseMigSourceDat" Padding="12,4"/>

									<!-- Target Assets -->
									<TextBlock Grid.Row="2" Grid.Column="0" Text="Target .spr File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MigTargetSprPath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="OnBrowseMigTargetSpr" Padding="12,4"/>

									<TextBlock Grid.Row="3" Grid.Column="0" Text="Target .dat File:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MigTargetDatPath}" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center"/>
									<Button Grid.Row="3" Grid.Column="2" Content="Browse..." Click="OnBrowseMigTargetDat" Padding="12,4"/>

									<!-- Version Info -->
									<TextBlock Grid.Row="4" Grid.Column="0" Text="Source Client Version:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MigSourceVersionText}" Width="120" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>

									<TextBlock Grid.Row="5" Grid.Column="0" Text="Target Client Version:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MigTargetVersionText}" Width="120" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>

									<!-- Compatibility Options -->
									<TextBlock Grid.Row="6" Grid.Column="0" Text="Source Extended IDs:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding MigSourceExtendedIds}"/>

									<TextBlock Grid.Row="7" Grid.Column="0" Text="Source Transparent:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding MigSourceTransparent}"/>

									<TextBlock Grid.Row="8" Grid.Column="0" Text="Source Improved Anim:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding MigSourceImprovedAnimations}"/>

									<TextBlock Grid.Row="9" Grid.Column="0" Text="Source Outfit Groups:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding MigSourceOutfitGroups}"/>

									<TextBlock Grid.Row="10" Grid.Column="0" Text="Target Extended IDs:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding MigTargetExtendedIds}"/>

									<TextBlock Grid.Row="11" Grid.Column="0" Text="Target Transparent:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding MigTargetTransparent}"/>

									<TextBlock Grid.Row="12" Grid.Column="0" Text="Target Improved Anim:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding MigTargetImprovedAnimations}"/>

									<TextBlock Grid.Row="13" Grid.Column="0" Text="Target Outfit Groups:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding MigTargetOutfitGroups}"/>

									<TextBlock Grid.Row="14" Grid.Column="0" Text="Target SPR Signature:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="14" Grid.Column="1" Text="{Binding MigTargetSprSignatureText}" Width="120" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>

									<TextBlock Grid.Row="15" Grid.Column="0" Text="Target DAT Signature:" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<TextBox Grid.Row="15" Grid.Column="1" Text="{Binding MigTargetDatSignatureText}" Width="120" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
								</Grid>

								<Button Content="Migrate Target Version" Command="{Binding ExecuteMigrationCommand}" IsEnabled="{Binding !IsBusy}" Background="#5E94FF" Foreground="#FFFFFF" Padding="20,10" HorizontalAlignment="Left" Margin="0,10,0,0"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>

		<!-- Bottom Status Bar -->
		<Border Grid.Row="2" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,20,0,0">
			<Grid ColumnDefinitions="*, Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<TextBlock Text="Status:" FontWeight="SemiBold" Foreground="#888888"/>
					<TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF"/>
				</StackPanel>
				<ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="150" Height="10" VerticalAlignment="Center"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>
