<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="NyxAssetsEditor.Views.Shell.WarningDialog"
		Title="Action Required"
		Width="400"
		SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		Background="#141414"
		RequestedThemeVariant="Dark"
		ShowInTaskbar="False">

	<Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
		<StackPanel Spacing="0">

			<!-- Header -->
			<Border Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="20,16">
				<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
					<Border Width="32" Height="32" CornerRadius="16" Background="#332B1A">
						<Image Source="/Assets/Icons/state/warning.png" Width="18" Height="18"/>
					</Border>
					<TextBlock Name="TitleText" Text="Action Required" FontSize="15" FontWeight="SemiBold"
							   Foreground="#F0F0F0" VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<!-- Body -->
			<Border Padding="20,16,20,10">
				<StackPanel Spacing="14">
					<TextBlock Name="MessageText" Text="Warning message goes here."
							   Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap"/>
					<Border Name="InfoBox" Background="#1E2A3A" BorderBrush="#3A5E8A" BorderThickness="1" CornerRadius="6" Padding="12" IsVisible="False">
						<StackPanel Spacing="8">
							<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
								<Image Source="/Assets/Icons/state/info.png" Width="14" Height="14" VerticalAlignment="Center"/>
								<TextBlock Text="How to fix:" FontWeight="SemiBold" Foreground="#9FC5E8" FontSize="12" VerticalAlignment="Center"/>
							</StackPanel>
							<TextBlock Name="InfoBoxText" Text="" Foreground="#BBDDFF" FontSize="11" TextWrapping="Wrap"/>
							<StackPanel Name="SnippetPanel" Spacing="6" Margin="0,4,0,0" IsVisible="False">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Grid.Column="0" Text="Suggested signatures.toml entry:" Foreground="#88BBEE" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
									<Button Grid.Column="1" Name="CopySnippetButton" Content="Copy Entry" Padding="8,2" FontSize="10" Background="#2A3D55" BorderBrush="#4A75A5" BorderThickness="1" Foreground="#D0E5FF" CornerRadius="3" Click="OnCopySnippetClick"/>
								</Grid>
								<TextBox Name="SnippetTextBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Cascadia Code, Courier New, monospace" FontSize="11" Background="#131B26" BorderBrush="#2D4666" BorderThickness="1" Foreground="#E0E0E0" Padding="8,6" CornerRadius="4"/>
							</StackPanel>
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>

			<!-- Buttons -->
			<Border Padding="20,10,20,20">
				<Grid HorizontalAlignment="Right">
					<Button Name="OkButton"
							Content="OK"
							Padding="20,6"
							Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1"
							Foreground="#E0E0E0" FontSize="12" CornerRadius="4"
							Click="OnOkClick"/>
				</Grid>
			</Border>

		</StackPanel>
	</Border>
</Window>
