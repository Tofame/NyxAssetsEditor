<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="NyxAssetsEditor.Views.Shell.ConfirmOpenDialog"
		Title="Archive Already Opened"
		Width="400"
		SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		Background="#141414"
		RequestedThemeVariant="Dark"
		ShowInTaskbar="False">

	<Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
		<StackPanel Spacing="0">

			<!-- Header -->
			<Border Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="20,16">
				<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
					<Border Width="32" Height="32" CornerRadius="16" Background="#2B3C56">
						<Image Source="/Assets/Icons/state/info.png" Width="16" Height="16"/>
					</Border>
					<TextBlock Text="Archive Already Opened" FontSize="15" FontWeight="SemiBold"
							   Foreground="#F0F0F0" VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<!-- Body -->
			<Border Padding="20,20,20,10">
				<StackPanel Spacing="14">
					<TextBlock Name="MessageText" Text="This archive is already opened in the Assets section. Do you want to open another instance of it?"
							   Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

			<!-- Buttons -->
			<Border Padding="20,10,20,20">
				<Grid ColumnDefinitions="*, Auto, Auto" HorizontalAlignment="Stretch">
					<Button Grid.Column="1" Name="ContinueButton"
							Content="Continue"
							Padding="16,6" Margin="0,0,8,0"
							Background="#1E3E62" BorderBrush="#2D5D92" BorderThickness="1"
							Foreground="#A0C5F0" FontSize="12" CornerRadius="4"
							Click="OnContinueClick"/>

					<Button Grid.Column="2" Name="CancelButton"
							Content="Cancel"
							Padding="16,6"
							Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1"
							Foreground="#AAAAAA" FontSize="12" CornerRadius="4"
							Click="OnCancelClick"/>
				</Grid>
			</Border>

		</StackPanel>
	</Border>
</Window>
